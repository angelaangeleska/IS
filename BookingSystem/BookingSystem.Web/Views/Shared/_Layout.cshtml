<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Booking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookingSystem.Web.styles.css" asp-append-version="true" />
    <style>
        body {
            background: #f7f7fa;
            font-family: 'Inter', Arial, sans-serif;
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07);
            overflow: hidden;
            transition: transform 0.18s, box-shadow 0.18s;
            display: flex;
            flex-direction: column;
        }

            .card:hover {
                transform: translateY(-4px) scale(1.015);
                box-shadow: 0 6px 24px rgba(0,0,0,0.13);
            }

        .card-img-top {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .card-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .card-meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.98rem;
            color: #757575;
            margin-bottom: 0.3rem;
        }

        .card-actions {
            margin-top: 1rem;
            display: flex;
            gap: 1rem;
        }

            .card-actions a {
                text-decoration: none;
                color: #007bff;
                font-weight: 500;
                transition: color 0.15s;
            }

                .card-actions a:hover {
                    color: #ff385c;
                }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            margin: 2rem 0;
        }

            .pagination a {
                padding: 0.4rem 0.9rem;
                border-radius: 8px;
                background: #fff;
                color: #007bff;
                text-decoration: none;
                border: 1px solid #e0e0e0;
                transition: background 0.15s, color 0.15s;
            }

                .pagination a.current {
                    background: #007bff;
                    color: #fff;
                    font-weight: 700;
                    border: 1px solid #007bff;
                }

                .pagination a.disabled {
                    color: #bbb;
                    pointer-events: none;
                    background: #f4f4f4;
                    border: 1px solid #e0e0e0;
                }

        .form-card {
            border-radius: 18px;
            border: none;
            background: #fff;
            margin-top: 2.5rem;
            margin-bottom: 2.5rem;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        }

            .form-card .card-body {
                padding: 2rem 2.5rem;
            }

        .form-group label {
            font-weight: 500;
            color: #333;
            margin-bottom: 0.3rem;
        }

        .form-control {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            font-size: 1.05rem;
            padding: 0.6rem 1rem;
            margin-bottom: 0.2rem;
            transition: border 0.15s;
        }

            .form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 0 2px #007bff22;
            }

        .form-check-label {
            font-weight: 400;
            color: #444;
        }

        .btn-primary {
            background: #007bff;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            letter-spacing: 0.5px;
            padding: 0.5rem 1.5rem;
            transition: background 0.17s;
        }

            .btn-primary:hover {
                background: #0069d9;
            }

        .btn-outline-secondary {
            border-radius: 8px;
            font-weight: 500;
            padding: 0.5rem 1.5rem;
        }

        .text-danger {
            font-size: 0.97rem;
            margin-top: 0.1rem;
            display: block;
        }

        .form-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 1.5rem;
        }

        @@media (max-width: 600px) {
            .form-card .card-body {
                padding: 1.2rem 0.7rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Accommodations" asp-action="Index">Booking</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Accommodations" asp-action="Index">Accommodations</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Cities" asp-action="Index">Cities</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Countries" asp-action="Index">Countries</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Reservations" asp-action="Index">My reservations</a>
                            </li>                            
                        }
                        
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="footer">
        <div class="container">
            &copy; 2025 - Booking System
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
