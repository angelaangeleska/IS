@model BookingSystem.Domain.DomainModels.Reservation

@{
    ViewData["Title"] = "Cancel Reservation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-card {
        border-radius: 18px;
        border: none;
        background: #fff;
        margin-top: 2.5rem;
        margin-bottom: 2.5rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        max-width: 880px;
        margin-left: auto;
        margin-right: auto;
    }

        .form-card .card-body {
            padding: 2rem 2.5rem;
        }

    .cancel-warning {
        color: #d93025;
        font-weight: 600;
        font-size: 1.35rem;
        margin-bottom: 1.2rem;
        text-align: center;
    }

    .reservation-details-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 0.1rem;
        margin-bottom: 1.5rem;
    }

    .cancel-label {
        font-weight: 500;
        color: #555;
        font-size: 0.97rem;
        width: 32%;
        padding-right: 0.5rem;
        white-space: nowrap;
        vertical-align: top;
    }

    .cancel-value {
        font-size: 1.04rem;
        font-weight: 500;
        color: #333;
        word-break: break-word;
    }

    .cancel-row {
        height: 1.6rem;
    }

    .cancel-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.3rem;
        justify-content: flex-end;
        border-top: 1px solid #ffeaea;
        padding-top: 1rem;
    }

    .btn-cancel {
        padding: 0.5rem 1.3rem;
        border-radius: 8px;
        font-weight: 500;
        background: #d93025;
        color: #fff;
        border: none;
        transition: background 0.2s;
    }

        .btn-cancel:hover {
            background: #b71c1c;
            color: #fff;
        }

    .btn-back {
        background: #f1f3f5;
        color: #495057;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        font-weight: 500;
        padding: 0.5rem 1.3rem;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-back:hover {
            background: #e9ecef;
        }
</style>

<div class="form-card">
    <div class="card-body">
        <h1 class="text-center mb-4">Cancel Reservation</h1>
        <div class="cancel-warning">
            <span class="material-icons" style="vertical-align: middle;"></span>
            Are you sure you want to cancel this reservation?
        </div>
        <table class="reservation-details-table">
            <tr class="cancel-row">
                <td class="cancel-label">Accommodation</td>
                <td class="cancel-value">@Model.Accommodation?.Name</td>
            </tr>
            <tr class="cancel-row">
                <td class="cancel-label">Check-in</td>
                <td class="cancel-value">@Model.CheckInDate.ToString("d")</td>
            </tr>
            <tr class="cancel-row">
                <td class="cancel-label">Check-out</td>
                <td class="cancel-value">@Model.CheckOutDate.ToString("d")</td>
            </tr>
            <tr class="cancel-row">
                <td class="cancel-label">Guests</td>
                <td class="cancel-value">@Model.NumberOfGuests</td>
            </tr>
            <tr class="cancel-row">
                <td class="cancel-label">Total Price</td>
                <td class="cancel-value">€@Model.TotalPrice.ToString("0.00")</td>
            </tr>
        </table>
        <form asp-action="Cancel" method="post" class="cancel-actions">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Confirm Cancellation" class="btn-cancel" />
            <a asp-action="Index" class="btn-back">Back to List</a>
        </form>
    </div>
</div>
