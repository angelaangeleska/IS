@model IEnumerable<BookingSystem.Domain.DomainModels.Reservation>
@{
    ViewData["Title"] = "My Reservations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="mb-4">My Reservations</h1>

<div class="card-grid">
    @foreach (var item in Model)
    {
        <div class="card">
            <img src="@item.Accommodation.ImageUrl" class="card-img-top" alt="@item.Accommodation.Name" />
            <div class="card-body">
                <h4 class="card-title">@item.Accommodation.Name</h4>
                <div class="card-meta">
                    <span>Check-in: @item.CheckInDate.ToString("d")</span>
                    <span>Check-out: @item.CheckOutDate.ToString("d")</span>
                </div>
                <div class="card-meta">
                    <span>Guests: @item.NumberOfGuests</span>
                    <span>Total: €@item.TotalPrice.ToString("0.00")</span>
                </div>
                <div class="card-meta">
                    <span>Booked: @item.CreatedOn.ToString("d")</span>
                </div>
                <div class="card-actions">
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a asp-action="Cancel" asp-route-id="@item.Id" class="text-danger">Cancel</a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        overflow: hidden;
        transition: transform 0.18s, box-shadow 0.18s;
        display: flex;
        flex-direction: column;
    }

        .card:hover {
            transform: translateY(-4px) scale(1.015);
            box-shadow: 0 6px 24px rgba(0,0,0,0.13);
        }

    .card-img-top {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }

    .card-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .card-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.98rem;
        color: #757575;
        margin-bottom: 0.3rem;
    }

    .card-actions {
        margin-top: 1rem;
        display: flex;
        gap: 1rem;
    }

        .card-actions a {
            text-decoration: none;
            color: #007bff;
            font-weight: 500;
            transition: color 0.15s;
        }

            .card-actions a:hover {
                color: #ff385c;
            }
</style>
