<!-- Views/Reservations/Create.cshtml -->
@model BookingSystem.Domain.DomainModels.Reservation

@{
    ViewData["Title"] = "Create Reservation";
}

<h1>Book @Model.Accommodation.Name</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <input type="hidden" name="accommodationId" value="@Model.AccommodationId" />

            <div class="form-group">
                <label asp-for="CheckInDate" class="control-label"></label>
                <input asp-for="CheckInDate"
                       type="date"
                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                       class="form-control" />
                <span asp-validation-for="CheckInDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CheckOutDate" class="control-label"></label>
                <input asp-for="CheckOutDate"
                       type="date"
                       min="@DateTime.Today.AddDays(2).ToString("yyyy-MM-dd")"
                       class="form-control" />
                <span asp-validation-for="CheckOutDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumberOfGuests" class="control-label"></label>
                <input asp-for="NumberOfGuests" class="form-control" />
                <span asp-validation-for="NumberOfGuests" class="text-danger"></span>
                <small class="text-muted">Capacity: @Model.Accommodation.Capacity guests</small>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Confirm Booking" class="btn btn-primary" />
                <a asp-controller="Accommodations" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <div class="col-md-4">
        <div class="card">
            <img src="@Model.Accommodation.ImageUrl" class="card-img-top" alt="@Model.Accommodation.Name">
            <div class="card-body">
                <h5>@Model.Accommodation.Name</h5>
                <p>@Model.Accommodation.Description</p>
                <p class="mb-0"><strong>Price:</strong> €@Model.Accommodation.PricePerNight/night</p>
            </div>
        </div>
    </div>
</div>
<script>
    document.getElementById('CheckInDate').addEventListener('change', function() {
        const checkIn = new Date(this.value);
        const nextDay = new Date(checkIn);
        nextDay.setDate(checkIn.getDate() + 1);

        document.getElementById('CheckOutDate').min =
            nextDay.toISOString().split('T')[0];
    });
</script>