@model IEnumerable<BookingSystem.Domain.DomainModels.Country>

@{
    ViewData["Title"] = "Countries";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Countries</h1>

<form asp-action="FetchCountries" method="post" class="mb-3">
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-cloud-download"></i> Fetch Countries
    </button>
</form>

<div class="card-grid">
    @foreach (var item in Model)
    {
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">@item.Name</h3>
                <p class="card-text">
                    <strong>Currency:</strong> @item.CurrencyName<br />
                    <strong>Code:</strong> @item.Code
                </p>
                @* <div class="card-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </div> *@
            </div>
        </div>
    }
</div>
