@using System.Security.Claims
@model BookingSystem.Domain.DomainModels.Accommodation

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .detail-card {
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        background: #fff;
        overflow: hidden;
        margin-top: 2rem;
    }

    .detail-header {
        padding: 1.5rem 2rem;
        background: #f8f9fa;
        border-bottom: 1px solid #eaeaea;
    }

    .detail-body {
        padding: 2rem;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .detail-item {
        margin-bottom: 1.3rem;
    }

    .detail-label {
        font-weight: 500;
        color: #555;
        margin-bottom: 0.4rem;
        font-size: 0.95rem;
    }

    .detail-value {
        font-size: 1.1rem;
        font-weight: 500;
        color: #333;
    }

    .detail-image {
        width: 100%;
        border-radius: 12px;
        margin-top: 1rem;
        max-height: 400px;
        object-fit: cover;
    }

    .status-badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .status-available {
        background: #e6f7ee;
        color: #0d8a4f;
    }

    .status-booked {
        background: #fde8e8;
        color: #d93025;
    }

    .detail-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }

    .btn-detail {
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-edit {
        background: #007bff;
        color: white;
        border: none;
    }

        .btn-edit:hover {
            background: #0069d9;
            color: white;
        }

    .btn-back {
        background: #f1f3f5;
        color: #495057;
        border: 1px solid #e0e0e0;
    }

        .btn-back:hover {
            background: #e9ecef;
        }
</style>

<div class="container">
    <div class="detail-card">
        <div class="detail-header">
            <h1 class="mb-0">@Model.Name</h1>
            <div class="d-flex align-items-center mt-2">
                <span class="badge bg-primary me-2">@Model.City?.Name</span>
                <span class="status-badge @(Model.IsAvailable ? "status-available" : "status-booked")">
                    @(Model.IsAvailable ? "Available" : "Booked")
                </span>
            </div>
        </div>

        <div class="detail-body">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="detail-image" alt="@Model.Name" />
            }

            <div class="detail-grid mt-4">
                <div class="detail-item">
                    <div class="detail-label">Description</div>
                    <div class="detail-value">@Model.Description</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">Address</div>
                    <div class="detail-value">@Model.Address</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">Price per night</div>
                    <div class="detail-value">€@Model.PricePerNight.ToString("0.00")</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">Capacity</div>
                    <div class="detail-value">@Model.Capacity guests</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">Rating</div>
                    <div class="detail-value">@Model.Rating.ToString("0.0")/5.0</div>
                </div>
            </div>

            <div class="detail-actions">
                @if (User.Identity.IsAuthenticated && Model.CreatedFromUserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-detail btn-edit">Edit</a>
                }
                <a asp-action="Index" class="btn-detail btn-back">Back to List</a>
            </div>

        </div>
    </div>
</div>
