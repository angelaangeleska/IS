@model BookingSystem.Domain.DomainModels.Accommodation

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-card {
        border-radius: 18px;
        border: none;
        background: #fff;
        margin-top: 2.5rem;
        margin-bottom: 2.5rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        max-width: 880px;
        margin-left: auto;
        margin-right: auto;
    }

        .form-card .card-body {
            padding: 2rem 2.5rem;
        }

    .form-group label {
        font-weight: 500;
        color: #333;
        margin-bottom: 0.3rem;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        font-size: 1.05rem;
        padding: 0.6rem 1rem;
        margin-bottom: 0.2rem;
        transition: border 0.15s;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 2px #007bff22;
        }

    .form-check-label {
        font-weight: 400;
        color: #444;
    }

    .btn-primary {
        background: #007bff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 0.5rem 1.5rem;
        transition: background 0.17s;
    }

        .btn-primary:hover {
            background: #0069d9;
        }

    .btn-outline-secondary {
        border-radius: 8px;
        font-weight: 500;
        padding: 0.5rem 1.5rem;
        margin-top: 1rem;
        display: inline-block;
    }

    .text-danger {
        font-size: 0.97rem;
        margin-top: 0.1rem;
        display: block;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 1.5rem;
    }

    }
</style>

<div class="form-card">
    <div class="card-body">
        <h1 class="text-center mb-4">Create Accommodation</h1>
        <form asp-action="Create" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Accommodation name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" placeholder="Description" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" placeholder="Full address" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CityId" class="form-label"></label>
                <select asp-for="CityId" class="form-control" asp-items="ViewBag.CityId"></select>
                <span asp-validation-for="CityId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PricePerNight" class="form-label"></label>
                <input asp-for="PricePerNight" class="form-control" placeholder="0.00" />
                <span asp-validation-for="PricePerNight" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" placeholder="Capacity" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Rating" class="form-label"></label>
                <input asp-for="Rating" class="form-control" placeholder="0.0 - 5.0" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="form-group mb-4 form-check">
                <input class="form-check-input" asp-for="IsAvailable" />
                <label class="form-check-label" asp-for="IsAvailable"></label>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn-outline-secondary">Back to List</a>
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
