@model BookingSystem.Domain.DomainModels.Accommodation

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .delete-card {
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        background: #fff;
        overflow: hidden;
        margin-top: 2rem;
        max-width: 880px; 
        margin-left: auto;
        margin-right: auto;
        border: 1.5px solid #ffd6d6;
    }

    .delete-image {
        width: 100%;
        max-height: 220px;
        object-fit: cover;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        border-bottom: 1px solid #ffeaea;
    }

    .delete-header {
        padding: 1rem 1.5rem 0.7rem 1.5rem;
        background: #fff4f4;
        border-bottom: 1px solid #ffeaea;
        text-align: center;
    }

        .delete-header h1 {
            color: #d93025;
            font-size: 1.7rem;
            margin-bottom: 0.2rem;
        }

        .delete-header h3 {
            color: #b71c1c;
            font-weight: 600;
            margin-bottom: 0;
            font-size: 1.1rem;
        }

    .delete-body {
        padding: 1.1rem 1.5rem 1.3rem 1.5rem;
    }

    .delete-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 0.1rem;
    }

    .delete-label {
        font-weight: 500;
        color: #555;
        font-size: 0.97rem;
        width: 32%;
        padding-right: 0.5rem;
        white-space: nowrap;
        vertical-align: top;
    }

    .delete-value {
        font-size: 1.04rem;
        font-weight: 500;
        color: #333;
        word-break: break-word;
    }

    .delete-row {
        height: 1.6rem;
    }

    .address-city-row .delete-label {
        vertical-align: middle;
    }

    .address-city-flex {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

        .address-city-flex span {
            display: block;
            min-width: 180px;
        }

    .status-badge {
        display: inline-block;
        padding: 0.22rem 0.7rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 0.92rem;
        margin-top: 0.1rem;
    }

    .status-available {
        background: #e6f7ee;
        color: #0d8a4f;
    }

    .status-booked {
        background: #fde8e8;
        color: #d93025;
    }

    .delete-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.3rem;
        justify-content: flex-end;
        border-top: 1px solid #ffeaea;
        padding-top: 1rem;
    }

    .btn-delete {
        padding: 0.5rem 1.3rem;
        border-radius: 8px;
        font-weight: 500;
        background: #d93025;
        color: #fff;
        border: none;
        transition: background 0.2s;
    }

        .btn-delete:hover {
            background: #b71c1c;
            color: #fff;
        }

    .btn-back {
        background: #f1f3f5;
        color: #495057;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        font-weight: 500;
        padding: 0.5rem 1.3rem;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-back:hover {
            background: #e9ecef;
        }

    .address-city-flex {
        flex-direction: column;
        gap: 0.2rem;
    }

    }

    .delete-table .delete-label {
        width: 44%;
    }

    }
</style>

<div class="container">
    <div class="delete-card">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="delete-image" alt="@Model.Name" />
        }
        <div class="delete-header">
            <h1>Delete</h1>
            <h3>Are you sure you want to delete this accommodation?</h3>
        </div>
        <div class="delete-body">
            <table class="delete-table">
                <tr class="delete-row">
                    <td class="delete-label">Name</td>
                    <td class="delete-value">@Model.Name</td>
                </tr>
                <tr class="delete-row">
                    <td class="delete-label">Description</td>
                    <td class="delete-value">@Model.Description</td>
                </tr>
                <tr class="delete-row address-city-row">
                    <td class="delete-label">Address / City</td>
                    <td class="delete-value">
                        <div class="address-city-flex">
                            <span>@Model.Address</span>
                            <span>@Model.City?.Name</span>
                        </div>
                    </td>
                </tr>
                <tr class="delete-row">
                    <td class="delete-label">Price per night</td>
                    <td class="delete-value">€@Model.PricePerNight.ToString("0.00")</td>
                </tr>
                <tr class="delete-row">
                    <td class="delete-label">Capacity</td>
                    <td class="delete-value">@Model.Capacity guests</td>
                </tr>
                <tr class="delete-row">
                    <td class="delete-label">Rating</td>
                    <td class="delete-value">@Model.Rating.ToString("0.0") / 5.0</td>
                </tr>
                <tr class="delete-row">
                    <td class="delete-label">Status</td>
                    <td class="delete-value">
                        <span class="status-badge @(Model.IsAvailable ? "status-available" : "status-booked")">
                            @(Model.IsAvailable ? "Available" : "Booked")
                        </span>
                    </td>
                </tr>
            </table>
            <form asp-action="Delete" class="delete-actions">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Delete" class="btn-delete" />
                <a asp-action="Index" class="btn-back">Back to List</a>
            </form>
        </div>
    </div>
</div>
