@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-card {
        border-radius: 18px;
        border: none;
        background: #fff;
        margin-top: 2.5rem;
        margin-bottom: 2.5rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        max-width: 880px;
        margin-left: auto;
        margin-right: auto;
    }

        .form-card .card-body {
            padding: 2rem 2.5rem;
        }

    .form-group label {
        font-weight: 500;
        color: #333;
        margin-bottom: 0.3rem;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        font-size: 1.05rem;
        padding: 0.8rem 1rem;
        margin-bottom: 0.2rem;
        transition: border 0.15s;
        height: auto;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 2px #007bff22;
        }

    .btn-primary {
        background: #007bff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 0.8rem 1.5rem;
        transition: background 0.17s;
        font-size: 1.05rem;
    }

        .btn-primary:hover {
            background: #0069d9;
        }

    .text-danger {
        font-size: 0.97rem;
        margin-top: 0.1rem;
        display: block;
    }

    .external-auth-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1.5rem;
    }

    .auth-divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 1.5rem 0;
    }

        .auth-divider::before,
        .auth-divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #e0e0e0;
        }

        .auth-divider:not(:empty)::before {
            margin-right: 1rem;
        }

        .auth-divider:not(:empty)::after {
            margin-left: 1rem;
        }

    .external-btn {
        border-radius: 8px;
        font-weight: 500;
        padding: 0.8rem 1.5rem;
        margin-bottom: 0.8rem;
        width: 100%;
        text-align: center;
    }

    .form-title {
        text-align: center;
        margin-bottom: 1.5rem;
        font-weight: 600;
        color: #333;
    }
</style>

<div class="form-card">
    <div class="card-body">
        <h1 class="text-center mb-4">@ViewData["Title"]</h1>

        <div class="row">
            <div class="col-md-12">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <h2 class="form-title">Create a new account</h2>

                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.FirstName">First Name</label>
                        <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" placeholder="Enter first name" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.LastName">Last Name</label>
                        <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Enter last name" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Password">Password</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Create password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-primary">Register</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
